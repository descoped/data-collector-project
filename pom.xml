<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" child.project.url.inherit.append.path="false" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- Parent and aggregator of every module. All modules share this version and are released together. -->
    <groupId>io.descoped.dc</groupId>
    <artifactId>data-collector-project</artifactId>
    <version>3.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Data Collector Project</name>
    <description>Data Collector: a specification driven HTTP crawler that pages through APIs and writes the content to
        rawdata-client topics. The specification DSL and its API, the execution engine, the rawdata content stream,
        the server and its test utilities.
    </description>
    <url>https://github.com/descoped/data-collector-project</url>
    <inceptionYear>2019</inceptionYear>

    <modules>
        <module>data-collector-bom</module>
        <module>data-collector-api</module>
        <module>data-collector-server-base</module>
        <module>data-collector-testutils</module>
        <module>data-collector-connector-content-stream-discarding</module>
        <module>data-collector-connector-content-stream-rawdata</module>
        <module>data-collector-core</module>
        <module>data-collector-server</module>
        <module>data-collector-samples</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- Reproducible builds: every jar entry gets this time, so the same commit builds the same bytes and the same
             images. The pull request that sets a release's version sets it to the release time. -->
        <project.build.outputTimestamp>2026-11-18T12:00:00Z</project.build.outputTimestamp>
        <!-- -Xlint:all -Werror is the rule. A module that is not yet revised lists the lint categories it still
             breaks here, as ",-unchecked,-rawtypes" and so on; its revision empties the list. -->
        <lint.exclusions/>
        <lint.this-escape/>
        <doclint.exclusions/>
        <!-- The JaCoCo agent: the coverage profile's prepare-agent sets it. Every module that gives surefire an
             argLine starts it with @{argLine}, so coverage reaches its tests; empty when coverage is off. -->
        <argLine/>
        <!-- Tests tagged "live" call real public APIs (brreg). The default build leaves them out; -P live runs only
             them. -->
        <surefire.groups/>
        <surefire.excludedGroups>live</surefire.excludedGroups>

        <!-- Dependency versions. Kept as properties, not in dependencyManagement, so that importing
             data-collector-bom (which inherits this POM) manages the data collector modules only. -->

        <!-- The Descoped libraries: rawdata-client 3 needs service-provider-api 3 under the module name 2 used, so these
             move between majors together. -->
        <service-provider-api.version>3.0.1</service-provider-api.version>
        <dynamic-configuration.version>3.0.1</dynamic-configuration.version>
        <secrets-client-api.version>3.0.0</secrets-client-api.version>
        <secrets-provider.version>3.0.0</secrets-provider.version>
        <encryption-util.version>3.0.1</encryption-util.version>
        <rawdata-client.version>3.1.0-SNAPSHOT</rawdata-client.version>

        <slf4j.version>2.0.20</slf4j.version>
        <log4j2.version>2.26.1</log4j2.version>
        <disruptor.version>4.0.0</disruptor.version>
        <jansi.version>2.4.3</jansi.version>
        <jackson.version>2.23.0</jackson.version>
        <jackson-annotations.version>2.23</jackson-annotations.version>
        <jackson-jq.version>1.6.5</jackson-jq.version>
        <commons-jexl3.version>3.2.1</commons-jexl3.version>
        <classgraph.version>4.8.200</classgraph.version>
        <methanol.version>1.9.0</methanol.version>
        <byte-buddy.version>1.18.17</byte-buddy.version>
        <prometheus-simpleclient.version>0.16.0</prometheus-simpleclient.version>
        <bouncycastle.version>1.87</bouncycastle.version>
        <java-jwt.version>4.6.2</java-jwt.version>
        <undertow.version>2.4.4.Final</undertow.version>
        <freemarker.version>2.3.35</freemarker.version>
        <tika.version>4.2.0</tika.version>
        <lmdbjava.version>0.9.3</lmdbjava.version>
        <jnr-ffi.version>2.3.7</jnr-ffi.version>
        <javax-inject.version>1</javax-inject.version>
        <h2.version>2.5.252</h2.version>
        <snappy.version>1.1.10.12</snappy.version>
        <junit.version>6.1.3</junit.version>
        <assertj.version>3.27.7</assertj.version>
    </properties>

    <licenses>
        <license>
            <name>The Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Ove Ranheim</name>
            <email>ove.ranheim@gmail.com</email>
            <url>https://www.linkedin.com/in/overanheim/</url>
        </developer>
    </developers>

    <!-- The modules live in this repository: their url and scm are the project's, not <url>/<artifactId>. -->
    <scm child.scm.connection.inherit.append.path="false" child.scm.developerConnection.inherit.append.path="false" child.scm.url.inherit.append.path="false">
        <connection>scm:git:git://github.com/descoped/data-collector-project.git</connection>
        <developerConnection>scm:git:git@github.com:descoped/data-collector-project.git</developerConnection>
        <url>https://github.com/descoped/data-collector-project/tree/master</url>
        <tag>HEAD</tag>
    </scm>

    <!-- SNAPSHOTs of the Descoped libraries, read from Descoped's AWS CodeArtifact repository without credentials.
         Release dependencies are resolved from Maven Central. The id differs from the publishing server's
         (descoped-snapshots), so Maven never sends the CodeArtifact token to maven.descoped.io. -->
    <repositories>
        <repository>
            <id>descoped-snapshots-public</id>
            <url>https://maven.descoped.io/</url>
            <releases>
                <enabled>false</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>

    <!-- No <distributionManagement>, here or in a profile: CI's job snapshot names maven.descoped.io on its command
         line (altSnapshotDeploymentRepository), which applies to SNAPSHOTs only, so a release version has no
         repository to deploy to. The samples are not published (maven.deploy.skip). -->

    <profiles>
        <!-- The tests tagged "live", against real public APIs, and only those: ./mvnw verify -P live. A module
             without any finds none, so -Dsurefire.failIfNoSpecifiedTests is not needed. -->
        <profile>
            <id>live</id>
            <properties>
                <surefire.groups>live</surefire.groups>
                <surefire.excludedGroups/>
            </properties>
        </profile>
        <!-- javac 21 added the lint category this-escape, and javac 17 rejects its name. The 2.x classes call
             overridable methods from constructors; to keep them as they are (not final), the category is turned off
             where javac knows it. -->
        <profile>
            <id>jdk21-lint</id>
            <activation>
                <jdk>[21,)</jdk>
            </activation>
            <properties>
                <lint.this-escape>,-this-escape</lint.this-escape>
            </properties>
        </profile>

        <profile>
            <id>coverage</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <version>0.8.16</version>
                        <executions>
                            <execution>
                                <id>prepare-agent</id>
                                <goals>
                                    <goal>prepare-agent</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>report</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>report</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- One SonarCloud project for the whole reactor; each module reports its own JaCoCo XML. -->
        <profile>
            <id>sonar</id>
            <properties>
                <sonar.host.url>https://sonarcloud.io</sonar.host.url>
                <sonar.organization>descoped</sonar.organization>
                <sonar.projectKey>descoped_data-collector-project</sonar.projectKey>
                <sonar.projectName>Data Collector project</sonar.projectName>
                <sonar.coverage.jacoco.xmlReportPaths>target/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.sonarsource.scanner.maven</groupId>
                        <artifactId>sonar-maven-plugin</artifactId>
                        <version>5.9.0.7382</version>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.16.0</version>
                    <configuration>
                        <!-- No annotation processors are used. javac before 23 runs any it finds on the class path
                             (log4j-core ships one), and -Xlint:all then fails on "No processor claimed". -->
                        <proc>none</proc>
                        <!-- -classfile: dependencies' class files reference annotation classes they do not ship
                             (log4j-core's SpotBugs annotations); that is not this project's code. -->
                        <compilerArgs>
                            <arg>-Xlint:all,-classfile${lint.this-escape}${lint.exclusions}</arg>
                            <arg>-Werror</arg>
                        </compilerArgs>
                    </configuration>
                    <executions>
                        <!-- The tests are compiled into their module (patch mode), so the module's export lints would
                             apply to test classes; tests are not API. -->
                        <execution>
                            <id>default-testCompile</id>
                            <configuration>
                                <compilerArgs combine.children="append">
                                    <arg>-Xlint:-exports,-missing-explicit-ctor</arg>
                                </compilerArgs>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.5.1</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.6.1</version>
                    <configuration>
                        <groups>${surefire.groups}</groups>
                        <excludedGroups>${surefire.excludedGroups}</excludedGroups>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>3.12.0</version>
                    <configuration>
                        <doclint>all${doclint.exclusions}</doclint>
                        <failOnWarnings>true</failOnWarnings>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>3.11.0</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>3.2.0</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>3.2.0</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>3.4.0</version>
                </plugin>

                <!-- help:evaluate and versions:set, used by CI's snapshot job -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-help-plugin</artifactId>
                    <version>3.6.0</version>
                </plugin>

                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>versions-maven-plugin</artifactId>
                    <version>2.25.3</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.7.0</version>
                <executions>
                    <execution>
                        <id>enforce</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>${java.version}</version>
                                </requireJavaVersion>
                                <!-- Maven 3: the wrapper pins 3.10; Maven 4 is not tested. -->
                                <requireMavenVersion>
                                    <version>[3.6.3,4)</version>
                                </requireMavenVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
